{
	"lock": false,
	"name": "@li/lorem-babel",
	"version": "0.4.0",
	"exports": {
		".": "./src/mod.ts",
		"./locales": "./src/locales.ts",
		"./locales/ar": "./src/locales/ar.json",
		"./locales/bg": "./src/locales/bg.json",
		"./locales/cs": "./src/locales/cs.json",
		"./locales/da": "./src/locales/da.json",
		"./locales/de": "./src/locales/de.json",
		"./locales/el": "./src/locales/el.json",
		"./locales/en": "./src/locales/en.json",
		"./locales/en-GB": "./src/locales/en-GB.json",
		"./locales/es": "./src/locales/es.json",
		"./locales/es-419": "./src/locales/es-419.json",
		"./locales/et": "./src/locales/et.json",
		"./locales/fi": "./src/locales/fi.json",
		"./locales/fr": "./src/locales/fr.json",
		"./locales/got": "./src/locales/got.json",
		"./locales/he": "./src/locales/he.json",
		"./locales/hu": "./src/locales/hu.json",
		"./locales/id": "./src/locales/id.json",
		"./locales/it": "./src/locales/it.json",
		"./locales/ja": "./src/locales/ja.json",
		"./locales/ko": "./src/locales/ko.json",
		"./locales/lorem": "./src/locales/lorem.json",
		"./locales/lv": "./src/locales/lv.json",
		"./locales/nb": "./src/locales/nb.json",
		"./locales/nl": "./src/locales/nl.json",
		"./locales/osa": "./src/locales/osa.json",
		"./locales/pl": "./src/locales/pl.json",
		"./locales/pt": "./src/locales/pt.json",
		"./locales/pt-PT": "./src/locales/pt-PT.json",
		"./locales/ro": "./src/locales/ro.json",
		"./locales/ru": "./src/locales/ru.json",
		"./locales/sk": "./src/locales/sk.json",
		"./locales/sl": "./src/locales/sl.json",
		"./locales/sv": "./src/locales/sv.json",
		"./locales/th": "./src/locales/th.json",
		"./locales/tr": "./src/locales/tr.json",
		"./locales/uk": "./src/locales/uk.json",
		"./locales/vi": "./src/locales/vi.json",
		"./locales/zh": "./src/locales/zh.json",
		"./locales/zh-TW": "./src/locales/zh-TW.json"
	},
	"tasks": {
		"start": "deno run -A --watch ./demo/main.ts",
		"test": "deno test -A src",
		"test:update-snapshot": "UPDATE_SNAPSHOT=1 deno test -A --no-check src",
		"build": "deno run -A scripts/updateExports.ts"
	},
	"imports": {
		"@li/http-saver": "jsr:@li/http-saver@^0.5.0",
		"@li/is-dom-exception": "jsr:@li/is-dom-exception@^0.2.0",
		"@li/regexp-escape-polyfill": "jsr:@li/regexp-escape-polyfill@^0.3.4",
		"@std/assert": "jsr:@std/assert@^0.225.1",
		"@std/html": "jsr:@std/html@^1.0.4",
		"@std/http": "jsr:@std/http@^1.0.19",
		"@std/jsonc": "jsr:@std/jsonc@^1.0.1",
		"@std/media-types": "jsr:@std/media-types@^1.1.0",
		"@std/path": "jsr:@std/path@^1.0.3",
		"@std/random": "jsr:@std/random@^0.1.2",
		"@std/text": "jsr:@std/text@^1.0.15",
		"@types/mustache": "npm:@types/mustache@^4.2.6",
		"@types/prismjs": "npm:@types/prismjs@^1.26.5",
		"~/": "./src/",
		"marked": "npm:marked@^16.0.0",
		"marked-alert": "npm:marked-alert@^2.1.2",
		"marked-highlight": "npm:marked-highlight@^2.2.2",
		"marked-smartypants": "npm:marked-smartypants@^1.1.10",
		"mustache": "npm:mustache@^4.2.0",
		"prismjs": "npm:prismjs@^1.30.0"
	},
	"fmt": {
		"semiColons": false,
		"useTabs": true,
		"lineWidth": 120,
		"indentWidth": 4,
		"singleQuote": true,
		"proseWrap": "preserve",
		"exclude": []
	}
}
